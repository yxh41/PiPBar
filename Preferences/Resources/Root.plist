<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>title</key>
	<string>PiPBar</string>
	<key>items</key>
	<array>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>总开关</string>
			<key>footerText</key>
			<string>画中画增强：外框 + 底部控制条（roothide / iOS 16）。改任意项立即生效，无需注销。</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>defaults</key>
			<string>com.yxh41.pipbar</string>
			<key>key</key>
			<string>Enabled</string>
			<key>label</key>
			<string>启用 PiPBar</string>
			<key>default</key>
			<true/>
			<key>footnote</key>
			<string>总开关。关闭后画中画恢复原样。</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>外观（壳包在视频外面：顶/左右同宽，底部加宽）</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>defaults</key>
			<string>com.yxh41.pipbar</string>
			<key>key</key>
			<string>ShowFrame</string>
			<key>label</key>
			<string>显示外框</string>
			<key>default</key>
			<true/>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>defaults</key>
			<string>com.yxh41.pipbar</string>
			<key>key</key>
			<string>ShowButtons</string>
			<key>label</key>
			<string>显示控制按钮</string>
			<key>default</key>
			<true/>
			<key>footnote</key>
			<string>底部三颗：上一个 / 播放暂停 / 下一个。左右键走 MediaRemote 切歌通道（系统路由到 App 的 MPRemoteCommandCenter）；若当前 App 没有切歌能力（如普通网页视频只有单条内容），自动回退为 ±10 秒快退/快进。</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>defaults</key>
			<string>com.yxh41.pipbar</string>
			<key>key</key>
			<string>PreferTrackSkip</string>
			<key>label</key>
			<string>左右键优先切歌</string>
			<key>default</key>
			<true/>
			<key>footnote</key>
			<string>开启后左右键先尝试「上一个/下一个」（MediaRemote kMRPreviousTrack/kMRNextTrack），App 不支持时自动回退 ±10 秒快退快进；关闭则始终只做 ±10 秒快退快进。</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSliderCell</string>
			<key>defaults</key>
			<string>com.yxh41.pipbar</string>
			<key>key</key>
			<string>FrameWidth</string>
			<key>label</key>
			<string>外框宽度（顶/左右边框粗细）</string>
			<key>min</key>
			<real>4</real>
			<key>max</key>
			<real>24</real>
			<key>minValueText</key>
			<string>4</string>
			<key>maxValueText</key>
			<string>24</string>
			<key>default</key>
			<real>8</real>
			<key>footnote</key>
			<string>单位 pt：视频顶部与左右三边黑边的厚度。数值越大壳越厚。</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSStaticTextCell</string>
			<key>label</key>
			<string>外框宽度：当前 8 pt</string>
			<key>key</key>
			<string>FrameWidthVal</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSliderCell</string>
			<key>defaults</key>
			<string>com.yxh41.pipbar</string>
			<key>key</key>
			<string>BarHeight</string>
			<key>label</key>
			<string>底部高度（视频下方黑边条）</string>
			<key>min</key>
			<real>28</real>
			<key>max</key>
			<real>80</real>
			<key>minValueText</key>
			<string>28</string>
			<key>maxValueText</key>
			<string>80</string>
			<key>default</key>
			<real>40</real>
			<key>footnote</key>
			<string>单位 pt：视频底部黑边的厚度。控制按钮（上一曲/播放/下一曲）另叠加在视频底部内侧。</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSStaticTextCell</string>
			<key>label</key>
			<string>底部高度：当前 40 pt</string>
			<key>key</key>
			<string>BarHeightVal</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>日志（排障用）</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>defaults</key>
			<string>com.yxh41.pipbar</string>
			<key>key</key>
			<string>FileLog</string>
			<key>label</key>
			<string>文件日志</string>
			<key>default</key>
			<true/>
			<key>footnote</key>
			<string>默认开启。写入 /var/mobile/Library/Logs/PiPBar.log（Filza 直接翻，超 256KB 自动清空重记）。</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>defaults</key>
			<string>com.yxh41.pipbar</string>
			<key>key</key>
			<string>DebugLog</string>
			<key>label</key>
			<string>调试日志（视图层级 HIER）</string>
			<key>default</key>
			<false/>
		</dict>
	</array>
</dict>
</plist>
